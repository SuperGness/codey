{
  "schemaVersion": 1,
  "revision": 13,
  "conflictResolution": "highest_priority_deny_wins",
  "fallback": "deny",
  "roles": {
    "codey_explorer": { "access": "write", "visual": true },
    "codey_worker": { "access": "write", "visual": true },
    "codey_reviewer": { "access": "write", "visual": true },
    "default": { "access": "write", "visual": true }
  },
  "rules": [
    {
      "id": "deny-nested-spawn",
      "priority": 1000,
      "effect": "deny",
      "actors": ["child"],
      "toolClasses": ["spawn"],
      "explanation": "子代理不能继续派生子代理，避免权限与预算跨层扩散。"
    },
    {
      "id": "deny-child-orchestration",
      "priority": 950,
      "effect": "deny",
      "actors": ["child"],
      "tools": ["wait_agent", "list_agents", "agent_status", "interrupt_agent", "followup_task"],
      "explanation": "子代理只可向根代理回报，不得等待、查看、中断或追派其他代理。"
    },
    {
      "id": "allow-role-capabilities",
      "priority": 800,
      "effect": "allow",
      "actors": ["child"],
      "roles": ["codey_explorer", "codey_worker", "codey_reviewer", "default"],
      "toolClasses": ["read", "write", "command", "network", "collaboration", "visual", "unknown"],
      "explanation": "角色按任务分工选择模型；工具仍受生命周期、角色能力和 Codex 原生权限约束。"
    },
    {
      "id": "deny-unknown-tool-class",
      "priority": 900,
      "effect": "deny",
      "actors": ["child"],
      "roles": ["codey_explorer"],
      "toolClasses": ["unknown"],
      "explanation": "未归类工具无法证明只读，检索子代理不得调用。"
    },
    {
      "id": "allow-unbound-collaboration",
      "priority": 100,
      "effect": "allow",
      "actors": ["child"],
      "toolClasses": ["collaboration"],
      "explanation": "缺少可恢复角色绑定时只保留向根代理发送消息；数据工具、副作用工具和编排工具全部 fail-closed。"
    }
  ]
}
